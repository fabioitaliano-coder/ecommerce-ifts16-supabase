# Copiá este archivo como .env y completá los valores. El .env NUNCA se sube a GitHub.
# Supabase > botón "Connect" (URL y publishable) y Settings > API Keys (secret).

# --- PÚBLICAS: viajan en el bundle del navegador (prefijo VITE_). ---
VITE_SUPABASE_URL=
# Clave "publishable" (sb_publishable_...). En proyectos viejos: "anon".
VITE_SUPABASE_PUBLISHABLE_KEY=

# --- PRIVADA: SOLO para scripts/ en tu máquina. ---
# Clave "secret" (sb_secret_...). Saltea RLS. NUNCA con VITE_, ni en Render/Vercel, ni en Git.
SUPABASE_SECRET_KEY=

# --- OPCIONAL: prueba del alta pública en test:rls ---
# Un email tuyo (nombre@gmail.com). El script le agrega un alias único (nombre+123@gmail.com).
# Supabase rechaza dominios inventados y enviará un mail de confirmación a esa casilla.
TEST_SIGNUP_EMAIL=
